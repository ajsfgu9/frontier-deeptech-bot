# =========================
# Required keys
# =========================
OPENROUTER_API_KEY=your_openrouter_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
SEND_RAW_FETCH_REPORT=false
SEND_RAW_FETCH_JSON=false

# =========================
# Model
# =========================
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
DEBUG_LLM=false

# =========================
# Storage
# =========================
DB_PATH=/app/data/frontier_deeptech_trends.db

# Liveness file touched at the end of every successful fetch cycle. Point a
# Docker HEALTHCHECK at this file's mtime to detect a stuck container
# without tailing logs (e.g. `find /app/data/heartbeat.txt -mmin -15`).
HEALTHCHECK_FILE=/app/data/heartbeat.txt

# =========================
# Logging
# =========================
# DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# =========================
# Runtime cadence
# =========================
FETCH_MINUTES=2
CHECK_QUEUE_SECONDS=1
FORCE_FLUSH_MINUTES=30
DIGEST_MINUTES=60
SEND_STARTUP_MESSAGE=true
SEND_EMPTY_DIGEST=false
INCLUDE_ALERTS_IN_DIGEST=false

MAX_ITEM_RETRIES=5

# =========================
# Fetch resilience
# =========================
FEED_FAILURE_THRESHOLD=4
FEED_COOLDOWN_MINUTES=60

HN_FETCH_WORKERS=8
ARXIV_FETCH_WORKERS=4

LLM_TEXT_FIELD_MAX_CHARS=500

# =========================
# Caps / token pressure control
# =========================
MAX_CANDIDATES_PER_RUN=1000
MAX_CANDIDATES_PER_FLUSH=96
CANDIDATE_QUEUE_MAX=480
QUEUE_FLUSH_LIMIT=1
LLM_BATCH_SIZE=12
LLM_MIN_SCORE=7.0
ALERT_THRESHOLD=7.5
MAX_ALERTS_PER_FLUSH=8
DIGEST_MAX_ITEMS=5

# =========================
# Existing sources (arXiv, Hacker News, Techmeme)
# =========================
ENABLE_ARXIV=true
ARXIV_RESULTS_PER_CATEGORY=20
# Frontier Deep-Tech arXiv categories across Genomics/Biomolecules/Neuro (q-bio.*), Robotics (cs.RO), Cryptography/AI/Test-Time Compute/Agents (cs.CR, cs.MA, cs.AI, cs.CL, cs.LG, cs.LO), and Space/Atmospheric Physics (physics.space-ph, astro-ph.IM, physics.ao-ph, physics.flu-dyn)
ARXIV_CATEGORIES=q-bio.GN,q-bio.BM,q-bio.NC,q-bio.TO,q-bio.QM,cs.RO,cs.CR,cs.MA,cs.AI,cs.CL,cs.LG,cs.LO,physics.space-ph,astro-ph.IM,physics.ao-ph,physics.flu-dyn

ENABLE_HACKERNEWS=true
HN_NEW_STORIES_PER_RUN=80

ENABLE_TECHMEME=true
TECHMEME_MAX_ITEMS=40

# =========================
# Step 1: specialist media across the 6 Frontier Deep-Tech Pillars
# =========================
ENABLE_SPECIALIST_RSS=true
SPECIALIST_RSS_MAX_ITEMS_PER_FEED=12
SPECIALIST_RSS_FEEDS=GEN Biotechnology=https://www.genengnews.com/feed/|Labiotech.eu=https://www.labiotech.eu/feed/|SynBioBeta=https://www.synbiobeta.com/feed;;https://news.google.com/rss/search?q=site:synbiobeta.com+when:7d&hl=en-US&gl=US&ceid=US:en|Neuroscience News=https://neurosciencenews.com/feed/|SpaceNews=https://spacenews.com/feed/|NASASpaceFlight=https://www.nasaspaceflight.com/feed/|Payload Space=https://payloadspace.com/feed/|The Robot Report=https://www.therobotreport.com/feed/|IEEE Spectrum Robotics=https://spectrum.ieee.org/feeds/topic/robotics.rss|Carbon Herald=https://carbonherald.com/feed/|IACR Cryptology ePrint=https://eprint.iacr.org/rss/rss.xml

# =========================
# Step 2: multi-disciplinary deep-tech & climate science feeds
# =========================
ENABLE_SUPPLY_CHAIN_RSS=true
SUPPLY_CHAIN_RSS_MAX_ITEMS_PER_FEED=12
SUPPLY_CHAIN_RSS_FEEDS=Ars Technica Science=https://feeds.arstechnica.com/arstechnica/science|Quanta Magazine=https://api.quantamagazine.org/v1/rss|Canary Media=https://www.canarymedia.com/rss.rss

# =========================
# Universal 4-Stage 403-Resilient HTML Scraper
# =========================
ENABLE_HTML_SCRAPER=true
HTML_SCRAPER_MAX_ITEMS_PER_SITE=12
HTML_SCRAPER_TARGETS=STAT News Biotech=https://www.statnews.com/category/biotech/;;/20\d{2}/\d{2}/\d{2}/[a-z0-9-]+|SpaceNews Launch=https://spacenews.com/segment/launch/;;/20\d{2}/[a-z0-9-]+|Carbon Herald Capture=https://carbonherald.com/category/carbon-capture/;;/[a-z0-9-]+/

# =========================
# Step 3: SEC EDGAR — market-wide full-text search (EFTS)
# =========================
ENABLE_SEC_EDGAR=false
SEC_USER_AGENT=Frontier-DeepTech-Trend-Bot/2.3 your_email@example.com
SEC_FORMS=8-K,10-Q,10-K,S-1,F-1,20-F,6-K
SEC_LOOKBACK_DAYS=3
SEC_MAX_ITEMS_PER_FETCH=40
SEC_EFTS_QUERY='"CRISPR" OR "base editing" OR "prime editing" OR "de novo protein" OR "mRNA platform" OR "brain-computer interface" OR "optogenetics" OR "reusable launch vehicle" OR "nuclear thermal propulsion" OR "optical inter-satellite" OR "humanoid robot" OR "direct air capture" OR "ocean alkalinity" OR "zero-knowledge proof" OR "post-quantum cryptography" OR "fully homomorphic encryption" OR "test-time compute" OR "autonomous agent"'
